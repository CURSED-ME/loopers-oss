{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tryloopers.com/schemas/security-event/v1.json",
  "title": "Loopers Security Event",
  "description": "Schema for structured security events emitted by Loopers",
  "version": "1.0.0",
  "oneOf": [
    { "$ref": "#/definitions/BudgetExceededEvent" },
    { "$ref": "#/definitions/BudgetThresholdEvent" },
    { "$ref": "#/definitions/LoopDetectedEvent" }
  ],
  "definitions": {
    "OWASPMetadata": {
      "type": "object",
      "properties": {
        "owasp_category": { "type": "string", "example": "LLM10:2025" },
        "owasp_name": { "type": "string", "example": "Unbounded Consumption" },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] }
      },
      "required": ["owasp_category", "owasp_name", "severity"]
    },
    "BudgetExceededEvent": {
      "type": "object",
      "properties": {
        "owasp": { "$ref": "#/definitions/OWASPMetadata" },
        "event": { "type": "string", "const": "budget_exceeded" },
        "timestamp": { "type": "string", "format": "date-time" },
        "key_hash": { "type": "string" },
        "key_name": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "window": { "type": "string" },
        "current_spend_usd": { "type": "number" },
        "budget_limit_usd": { "type": "number" },
        "blocked_request_cost_usd": { "type": "number" }
      },
      "required": ["owasp", "event", "timestamp", "key_hash", "provider"]
    },
    "BudgetThresholdEvent": {
      "type": "object",
      "properties": {
        "owasp": { "$ref": "#/definitions/OWASPMetadata" },
        "event": { "type": "string", "const": "budget_threshold" },
        "timestamp": { "type": "string", "format": "date-time" },
        "key_hash": { "type": "string" },
        "key_name": { "type": "string" },
        "provider": { "type": "string" },
        "window": { "type": "string" },
        "threshold_percent": { "type": "integer" },
        "current_spend_usd": { "type": "number" },
        "budget_limit_usd": { "type": "number" },
        "message": { "type": "string" }
      },
      "required": ["owasp", "event", "timestamp", "key_hash", "provider", "threshold_percent"]
    },
    "LoopDetectedEvent": {
      "type": "object",
      "properties": {
        "owasp": { "$ref": "#/definitions/OWASPMetadata" },
        "event": { "type": "string", "const": "loop_detected" },
        "timestamp": { "type": "string", "format": "date-time" },
        "key_hash": { "type": "string" },
        "key_name": { "type": "string" },
        "provider": { "type": "string" },
        "session_id": { "type": "string" },
        "rule": { "type": "string", "enum": ["fingerprint", "velocity", "stall"] },
        "detail": { "type": "string" },
        "blocked": { "type": "boolean" }
      },
      "required": ["owasp", "event", "timestamp", "key_hash", "provider", "session_id", "rule", "blocked"]
    }
  }
}
