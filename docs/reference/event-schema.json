{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tryloopers.com/schemas/security-event/v2.json",
  "title": "Loopers Security Event Envelope (v2)",
  "description": "Schema for structured security events emitted by Loopers, designed for EU AI Act compliance",
  "version": "2.0.0",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "2.0.0" },
    "event_id": { "type": "string" },
    "loopers_event_type": { "type": "string", "enum": ["BUDGET_BLOCK", "BUDGET_THRESHOLD", "LOOP_BLOCK", "LOOP_WARN", "AUTH_FAIL", "FAIL_CLOSED"] },
    "trace_id": { "type": "string" },
    "span_id": { "type": "string" },
    "request_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "properties": {
        "component": { "type": "string", "const": "loopers_proxy" },
        "version": { "type": "string" },
        "instance": { "type": "string" }
      },
      "required": ["component", "version"]
    },
    "owasp": {
      "type": "object",
      "properties": {
        "owasp_category": { "type": "string" },
        "owasp_name": { "type": "string" },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] }
      },
      "required": ["owasp_category", "owasp_name", "severity"]
    },
    "regulation": {
      "type": "array",
      "items": { "type": "string" }
    },
    "action": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["type", "reason"]
    },
    "event": { "type": "string" },
    "details": { "type": "object" }
  },
  "required": ["schema_version", "event_id", "loopers_event_type", "timestamp", "source", "owasp", "action", "event", "details"]
}
